diff --git a/apps/server/tests/harbinger-config.test.ts b/apps/server/tests/harbinger-config.test.ts
new file mode 100644
index 0000000..f758da6
--- /dev/null
+++ b/apps/server/tests/harbinger-config.test.ts
@@ -0,0 +1,118 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, expect, it } from "vitest";
+import { createHarbingerConfigRoutes } from "../src/routes/harbinger-config.js";
+
+const url = "/api/harbinger/config";
+const temporaryDirectories: string[] = [];
+
+afterEach(() => {
+  for (const directory of temporaryDirectories.splice(0)) {
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+function fixture(overrides: NodeJS.ProcessEnv = {}) {
+  const directory = mkdtempSync(join(tmpdir(), "harbinger-config-"));
+  temporaryDirectories.push(directory);
+  return createHarbingerConfigRoutes({
+    HARBINGER_MODEL_SETTINGS_MODULE: new URL(
+      "../../../../../covel/model-settings.mjs",
+      import.meta.url,
+    ).href,
+    HARBINGER_MODEL_SETTINGS_PATH: join(directory, "model-settings.json"),
+    HARBINGER_MODEL_NAME: "fixture-model",
+    HARBINGER_MODEL_URL:
+      "https://user:password@models.example/v1/private?token=value#fragment",
+    HARBINGER_MODEL_KEY: "secret-key",
+    HARBINGER_REASONING_EFFORT: "medium",
+    HARBINGER_OPENROUTER_API_KEY: "openrouter-fixture-secret",
+    SQLITE_PATH: "C:\\private\\data\\story.sqlite",
+    SERVER_PORT: "0",
+    ...overrides,
+  });
+}
+
+function modelUpdate(body: Record<string, unknown>) {
+  return {
+    method: "PUT",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  };
+}
+
+it("reports applied Harbinger settings without secrets or private paths", async () => {
+  const app = fixture();
+  const response = await app.request(
+    url,
+    {},
+    {
+      incoming: { socket: { localPort: 49151 } },
+    },
+  );
+  expect(response.status).toBe(200);
+  expect(response.headers.get("Cache-Control")).toBe("no-store");
+  const body = await response.text();
+  expect(body).not.toMatch(
+    /password|\/v1\/private|token=value|fragment|secret-key|openrouter-fixture-secret/,
+  );
+  expect(JSON.parse(body)).toMatchObject({
+    model: "fixture-model",
+    provider: "custom",
+    reasoningEffort: "medium",
+    port: 49151,
+    database: "story.sqlite",
+    providers: expect.arrayContaining([
+      expect.objectContaining({
+        id: "custom",
+        origin: "https://models.example",
+        credentialConfigured: true,
+      }),
+      expect.objectContaining({
+        id: "openrouter",
+        origin: "https://openrouter.ai",
+        credentialConfigured: true,
+      }),
+    ]),
+  });
+});
+
+it("applies the selected provider, model, and reasoning effort before the next read", async () => {
+  const app = fixture();
+  const update = {
+    provider: "openrouter",
+    model: "openai/gpt-5",
+    reasoningEffort: "high",
+  };
+  const response = await app.request(url, modelUpdate(update));
+  expect(response.status).toBe(200);
+  expect(response.headers.get("Cache-Control")).toBe("no-store");
+  expect(await response.json()).toMatchObject(update);
+  expect(await (await app.request(url)).json()).toMatchObject(update);
+});
+
+it("refuses an endpoint override or a provider with no key", async () => {
+  const app = fixture({ HARBINGER_OPENROUTER_API_KEY: "" });
+  const update = {
+    provider: "openrouter",
+    model: "openai/gpt-5",
+    reasoningEffort: null,
+  };
+  const override = await app.request(
+    url,
+    modelUpdate({ ...update, url: "https://untrusted.example/secret" }),
+  );
+  expect(override.status).toBe(400);
+  expect(await override.text()).not.toContain("untrusted.example");
+
+  const missing = await app.request(url, modelUpdate(update));
+  expect(missing.status).toBe(422);
+  expect(await missing.json()).toMatchObject({
+    error: expect.stringMatching(/key/i),
+  });
+  expect(await (await app.request(url)).json()).toMatchObject({
+    provider: "custom",
+    model: "fixture-model",
+  });
+});
