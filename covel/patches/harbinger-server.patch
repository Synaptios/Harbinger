diff --git a/apps/server/src/routes/harbinger-config.ts b/apps/server/src/routes/harbinger-config.ts
new file mode 100644
index 0000000..d1bbc14
--- /dev/null
+++ b/apps/server/src/routes/harbinger-config.ts
@@ -0,0 +1,157 @@
+import { win32 } from "node:path";
+import type { HttpBindings } from "@hono/node-server";
+import { readRuntimeEnv } from "@covel/shared";
+import { Hono, type Context } from "hono";
+import { bodyLimit } from "hono/body-limit";
+import { z } from "zod";
+import { errorBody, readJsonBody } from "../api-error.js";
+import { accessGuard } from "../host-profile.js";
+
+const configPath = "/api/harbinger/config";
+const modelRoutePath = "/api/harbinger/model-route";
+const modelRouteQuery = z.strictObject({
+  model: z.string().min(1).max(140),
+  provider: z.enum(["openai", "openrouter", "inworld"]).optional(),
+  requiredParameters: z.array(z.string().max(48)).max(16).optional(),
+});
+const selection = z.strictObject({
+  provider: z.enum(["openai", "openrouter", "custom"]),
+  model: z.string().min(1).max(240),
+  reasoningEffort: z.string().max(24).nullable(),
+});
+
+type ModelSelection = z.infer<typeof selection>;
+
+interface PublicModelSettings {
+  provider: ModelSelection["provider"] | null;
+  model: string | null;
+  reasoningEffort: string | null;
+  providers: {
+    id: ModelSelection["provider"];
+    label: string;
+    origin: string | null;
+    credentialConfigured: boolean;
+    reasoningEfforts: string[];
+  }[];
+}
+
+interface SettingsModule {
+  getStoryModelSettings(env: NodeJS.ProcessEnv): PublicModelSettings;
+  updateStoryModelSettings(
+    input: ModelSelection,
+    env: NodeJS.ProcessEnv,
+  ): PublicModelSettings;
+}
+
+export function createHarbingerConfigRoutes(source = process.env): Hono {
+  const app = new Hono();
+  const { serverPort, sqlitePath, storeBackend } = readRuntimeEnv(source);
+  const moduleUrl = URL.parse(source.HARBINGER_MODEL_SETTINGS_MODULE ?? "");
+
+  app.use(configPath, async (c, next) => {
+    c.header("Cache-Control", "no-store");
+    await next();
+  });
+
+  async function respond(c: Context, update?: ModelSelection) {
+    if (moduleUrl?.protocol !== "file:") {
+      return c.json(
+        errorBody("Harbinger’s story model settings are unavailable."),
+        503,
+      );
+    }
+    let service: SettingsModule;
+    try {
+      service = await import(moduleUrl.href);
+    } catch {
+      return c.json(
+        errorBody("Harbinger’s story model settings are unavailable."),
+        503,
+      );
+    }
+    try {
+      const { provider, model, reasoningEffort, providers } = update
+        ? service.updateStoryModelSettings(update, source)
+        : service.getStoryModelSettings(source);
+      const incoming = (c.env as HttpBindings | undefined)?.incoming;
+      return c.json({
+        provider,
+        model,
+        reasoningEffort,
+        providers: providers.map(
+          ({ id, label, origin, credentialConfigured, reasoningEfforts }) => ({
+            id,
+            label,
+            origin,
+            credentialConfigured,
+            reasoningEfforts,
+          }),
+        ),
+        port: incoming?.socket.localPort ?? (serverPort || null),
+        database: storeBackend === "sqlite" ? win32.basename(sqlitePath) : null,
+      });
+    } catch (err) {
+      if (
+        err instanceof Error &&
+        "status" in err &&
+        (err.status === 400 || err.status === 422 || err.status === 503)
+      ) {
+        return c.json(errorBody(err.message), err.status);
+      }
+      return c.json(
+        errorBody(
+          update
+            ? "Could not save Harbinger’s story model settings."
+            : "Could not read Harbinger’s story model settings.",
+        ),
+        500,
+      );
+    }
+  }
+
+  app.get(configPath, accessGuard("server.diagnostics"), (c) => respond(c));
+  app.post(modelRoutePath, accessGuard("server.settings"), bodyLimit({ maxSize: 4096 }), async (c) => {
+    c.header("Cache-Control", "no-store");
+    const body = await readJsonBody(c);
+    if (body instanceof Response) return body;
+    const validated = modelRouteQuery.safeParse(body.body);
+    if (!validated.success) return c.json(errorBody("Invalid Harbinger model selection."), 400);
+    const routeModule = URL.parse(source.HARBINGER_PROVIDER_ROUTES_MODULE ?? "");
+    if (routeModule?.protocol !== "file:") return c.json(errorBody("Harbinger model routing is unavailable."), 503);
+    try {
+      const { resolveStoryRoute } = await import(routeModule.href);
+      return c.json(await resolveStoryRoute(validated.data, source));
+    } catch (error) {
+      const status = error instanceof Error && "status" in error ? error.status : undefined;
+      if (error instanceof Error && (status === 400 || status === 422)) return c.json(errorBody(error.message), status);
+      return c.json(errorBody("Could not look up a compatible model route."), 503);
+    }
+  });
+  app.put(
+    configPath,
+    accessGuard("server.settings"),
+    bodyLimit({
+      maxSize: 4096,
+      onError: (c) =>
+        c.json(errorBody("Story model settings are too large."), 413),
+    }),
+    async (c) => {
+      const type = c.req
+        .header("content-type")
+        ?.split(";", 1)[0]
+        ?.trim()
+        .toLowerCase();
+      if (type !== "application/json") {
+        return c.json(errorBody("Send story model settings as JSON."), 415);
+      }
+      const json = await readJsonBody(c);
+      if (json instanceof Response) return json;
+      const parsed = selection.safeParse(json.body);
+      if (!parsed.success) {
+        return c.json(errorBody("Invalid story model settings."), 400);
+      }
+      return respond(c, parsed.data);
+    },
+  );
+  return app;
+}
