new file mode 100644
index 0000000..7cf16d2
--- /dev/null
+++ b/apps/web/src/components/AudioPlaylist.tsx
@@ -0,0 +1,179 @@
+import { useEffect, useRef, useState } from "react";
+import { useTranslation } from "react-i18next";
+import type { CatalogAction, MediaRef } from "@covel/shared";
+import { invokeCatalogAction } from "@/lib/catalog/catalog-actions.js";
+import { asRecord } from "@/lib/catalog/helpers.js";
+import { isMediaRef } from "@/lib/media-ref-utils.js";
+import { resolveMediaSrc } from "@/lib/media-resolve.js";
+
+interface Clip {
+  speaker: string;
+  ref: MediaRef | null;
+}
+
+interface Track {
+  turnId: string;
+  time: string;
+  failed: boolean;
+  clips: Clip[];
+}
+
+function readTracks(entries: unknown): Track[] {
+  if (!Array.isArray(entries)) return [];
+  const tracks = entries.flatMap((entry: unknown) => {
+    const track = asRecord(asRecord(entry)?.value);
+    if (typeof track?.turnId !== "string" || typeof track.time !== "string" || !Array.isArray(track.clips))
+      return [];
+    const clips = track.clips.flatMap((value: unknown) => {
+      const clip = asRecord(value);
+      return typeof clip?.speaker === "string"
+        ? [{ speaker: clip.speaker, ref: isMediaRef(clip.ref) ? clip.ref : null }] : [];
+    });
+    return [{ turnId: track.turnId, time: track.time, failed: track.status === "failed", clips }];
+  });
+  return tracks.sort((a, b) => a.time.localeCompare(b.time));
+}
+
+export function AudioPlaylist({ sessionId, entries, retryAction }: {
+  sessionId: string;
+  entries: unknown;
+  retryAction?: CatalogAction;
+}) {
+  const { t } = useTranslation();
+  const tracks = readTracks(entries);
+  const [continuous, setContinuous] = useState(false);
+  const [playing, setPlaying] = useState(false);
+  const [cursor, setCursor] = useState<{ turnId: string; index: number }>();
+  const [finished, setFinished] = useState(false);
+  const [src, setSrc] = useState("");
+  const [error, setError] = useState("");
+  const [requesting, setRequesting] = useState<string | null>(null);
+  const audio = useRef<HTMLAudioElement>(null);
+  const trackIndex = tracks.findIndex(track => track.turnId === cursor?.turnId);
+  const selected = tracks[trackIndex];
+  const clip = cursor && selected?.clips[cursor.index];
+
+  function start(track: Track, index = 0) {
+    setCursor({ turnId: track.turnId, index });
+    setFinished(false);
+    setPlaying(true);
+  }
+
+  useEffect(() => {
+    if (!continuous) return;
+    const next = cursor
+      ? finished && tracks.slice(trackIndex + 1).find(track => track.clips[0]?.ref)
+      : tracks.findLast(track => track.clips[0]?.ref);
+    if (next) start(next);
+  }, [continuous, cursor, finished, trackIndex, tracks]);
+
+  const ref = clip?.ref;
+  useEffect(() => {
+    setSrc("");
+    setError("");
+    if (!ref) return;
+    const controller = new AbortController();
+    let ownedUrl: string | undefined;
+    void resolveMediaSrc(ref, { sessionId, signal: controller.signal }).then(result => {
+      if (result.url.startsWith("blob:")) ownedUrl = result.url;
+      if (controller.signal.aborted) {
+        if (ownedUrl) URL.revokeObjectURL(ownedUrl);
+        return;
+      }
+      if (result.ok) setSrc(result.url);
+      else setError("Couldn't load this clip.");
+    }).catch(() => {
+      if (!controller.signal.aborted) setError("Couldn't load this clip.");
+    });
+    return () => {
+      controller.abort();
+      if (ownedUrl) URL.revokeObjectURL(ownedUrl);
+    };
+  }, [ref?.id, ref?.url, ref?.mime, sessionId]);
+
+  useEffect(() => {
+    const element = audio.current;
+    if (element && src && playing) void element.play().catch(() => setPlaying(false));
+    else element?.pause();
+  }, [playing, src]);
+
+  function finishClip() {
+    const next = cursor && selected?.clips[cursor.index + 1]?.ref;
+    if (cursor && next) {
+      start(selected, cursor.index + 1);
+      if (audio.current && next.id === ref?.id) {
+        audio.current.currentTime = 0;
+        void audio.current.play().catch(() => setPlaying(false));
+      }
+      return;
+    }
+    setFinished(true);
+    setPlaying(false);
+  }
+
+  async function retry(turnId?: string) {
+    if (!retryAction) return;
+    setRequesting(turnId ?? "latest");
+    try {
+      await invokeCatalogAction({ action: retryAction, sessionId, scope: { turnId }, t });
+    } finally {
+      setRequesting(null);
+    }
+  }
+
+  return (
+    <div className="space-y-3">
+      <button type="button" className="ui-btn ui-btn-secondary"
+        onClick={() => {
+          setContinuous(!continuous);
+          if (continuous) setPlaying(false);
+          else if (cursor && !finished) setPlaying(true);
+        }}>
+        {continuous ? "Disable continuous narration" : "Enable continuous narration"}
+      </button>
+      {selected && clip && (
+        <div className="space-y-1 rounded-(--radius-card) border border-border p-3">
+          <p className="text-xs text-muted-foreground" aria-live="polite">
+            {clip.speaker} · Clip {(cursor?.index ?? 0) + 1} of {selected.clips.length}
+          </p>
+          {error && <p role="status" className="text-sm text-muted-foreground">{error}</p>}
+          <audio ref={audio} src={src || undefined} onEnded={finishClip}
+            onError={() => setError("Couldn't load this clip.")} preload="auto" />
+          <button type="button" className="ui-btn ui-btn-quiet" disabled={!src}
+            onClick={() => {
+              if (!playing && audio.current) {
+                if (finished) audio.current.currentTime = 0;
+                void audio.current.play().catch(() => setPlaying(false));
+              }
+              setFinished(false);
+              setPlaying(!playing);
+            }}>{playing ? "Pause" : "Play"}</button>
+        </div>
+      )}
+      {tracks.length === 0 && <p className="text-xs text-muted-foreground">Narration appears after the story is saved.</p>}
+      {retryAction && (
+        <button type="button" className="ui-btn ui-btn-quiet" disabled={requesting !== null}
+          onClick={() => void retry()}>Generate latest passage</button>
+      )}
+      <ol className="space-y-1">
+        {tracks.map((track, index) => (
+          <li key={track.turnId} className="flex flex-wrap items-center justify-between gap-1 border-t border-border py-2">
+            <span className="text-xs">Passage {index + 1} · {track.clips.length} {track.clips.length === 1 ? "clip" : "clips"}</span>
+            <button type="button" className="ui-btn ui-btn-quiet" disabled={!track.clips[0]?.ref}
+              onClick={() => {
+                if (cursor?.turnId === track.turnId && cursor.index === 0 && audio.current) {
+                  audio.current.currentTime = 0;
+                  void audio.current.play().catch(() => setPlaying(false));
+                }
+                start(track);
+              }} aria-label={`Replay passage ${index + 1}`}>Replay</button>
+            {retryAction && track.failed && (
+              <button type="button" className="ui-btn ui-btn-quiet" disabled={requesting !== null}
+                onClick={() => void retry(track.turnId)} aria-label={`Retry narration for passage ${index + 1}`}>Retry narration</button>
+            )}
+          </li>
+        ))}
+      </ol>
+    </div>
+  );
+}
