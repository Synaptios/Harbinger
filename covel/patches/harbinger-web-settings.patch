diff --git a/apps/web/src/settings/panes/HarbingerTiers.tsx b/apps/web/src/settings/panes/HarbingerTiers.tsx
new file mode 100644
index 0000000..747aa33
--- /dev/null
+++ b/apps/web/src/settings/panes/HarbingerTiers.tsx
@@ -0,0 +1,152 @@
+import { useId, useState } from "react";
+import { Button } from "@/components/ui/button.js";
+import { ApiError, request } from "@/services/api/request.js";
+import { getParamOverrides, getProviderProfiles, getSlotConfig, type SlotConfigEntry } from "@/services/api/model-settings.js";
+import { upsertProviderModel } from "@/services/api/provider-model-profiles.js";
+import { useSession } from "@/stores/session-store.js";
+import { useSettingsRevision } from "../use-settings-revision.js";
+import { useSettingsStore } from "../use-settings.js";
+
+const tiers = {
+  story: { efficient: "deepseek-v3.2", balanced: "glm-5.3-flash", advanced: "sonnet-4.5" },
+  character: { moderate: "gemma-4-31b", high: "glm-5.3-flash", ultra: "sonnet-4.6" },
+  state: { moderate: "gemma-4-26b", high: "gemma-4-31b", ultra: "gemma-4-31b" },
+};
+const roleNames = { story: "Story", character: "Character", state: "State" };
+const roles = ["story", "character", "state"] as const;
+type Role = typeof roles[number];
+const defaultTiers = {
+  story: { tier: "balanced", model: /\/glm-5\.3-flash$/iu },
+  character: { tier: "high", model: /\/glm-5\.3-flash$/iu },
+  state: { tier: "high", model: /\/gemma-4-31b-it$/iu },
+};
+
+interface ModelRoute {
+  provider: string;
+  providerName: string;
+  name: string;
+  modelId: string;
+  baseUrl: string;
+  protocol: string;
+  estimatedCost: number | null;
+}
+
+function getRoute(model: string) {
+  return request<ModelRoute>("/api/harbinger/model-route", {
+    method: "POST", operatorAuth: true, silentErrors: true, body: JSON.stringify({ model }),
+  });
+}
+
+function label(value: string) {
+  return value.charAt(0).toUpperCase() + value.slice(1);
+}
+
+function selectedTier(role: Role, binding: SlotConfigEntry | undefined, defaultModel?: string) {
+  if (Object.keys(getParamOverrides()[role] ?? {}).length) return "custom";
+  const shipped = defaultTiers[role];
+  if (!binding && shipped.model.test(defaultModel ?? "")) return shipped.tier;
+  const ref = binding?.modelRef ?? binding?.presetId ?? "";
+  return Object.keys(tiers[role]).find(tier =>
+    ref.startsWith(`harbinger-tier-${role}-${tier}-`) || ref.startsWith(`slot-harbinger-tier-${role}-${tier}-`),
+  ) ?? "custom";
+}
+
+export function HarbingerTiers() {
+  const id = useId();
+  const store = useSettingsStore();
+  const { state } = useSession();
+  useSettingsRevision(["llm.providers", "llm.slotConfig", "llm.paramOverrides"]);
+  const [busy, setBusy] = useState(false);
+  const [errors, setErrors] = useState("");
+  const [chosen, setChosen] = useState<Partial<Record<Role, { tier: string; route: ModelRoute }>>>({});
+  const [previous, setPrevious] = useState(false);
+  const slots = getSlotConfig();
+
+  async function applyTier(role: Role, tier: string) {
+    const model = (tiers[role] as Record<string, string>)[tier];
+    if (!model || busy) return;
+    setErrors("");
+    setPrevious(false);
+    setBusy(true);
+    try {
+      const [route, complex] = await Promise.all([getRoute(model), role === "state" && tier === "ultra" ? getRoute("gemini-3-flash") : undefined]);
+      let profiles = getProviderProfiles();
+      const selection = { ...getSlotConfig() };
+      const parameters = { ...getParamOverrides() };
+      function bind(slot: string, target: ModelRoute, identifier: string) {
+        const updated = upsertProviderModel(profiles, {
+          providerId: target.provider, providerName: target.providerName, modelId: target.modelId,
+          baseUrl: target.baseUrl, modelProtocol: target.protocol, modelName: `${label(tier)} · ${target.name}`,
+        }, () => `harbinger-tier-${identifier}-${tier}-${target.provider}`);
+        profiles = updated.profiles;
+        selection[slot] = { modelRef: updated.modelRef };
+      }
+      bind(role, route, role);
+      delete parameters[role];
+      if (role === "state") {
+        delete selection["state-complex"];
+        delete parameters["state-complex"];
+        if (complex) bind("state-complex", complex, "state-complex");
+      }
+      await store.setMany({ "llm.providers": profiles, "llm.slotConfig": selection, "llm.paramOverrides": parameters });
+      setChosen(values => ({ ...values, [role]: { tier, route } }));
+    } catch (cause) {
+      setErrors(cause instanceof ApiError ? cause.response?.error ?? "Could not apply this tier." : "Could not apply this tier.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function restorePrevious() {
+    setBusy(true);
+    setErrors("");
+    try {
+      const selection = { ...getSlotConfig() };
+      const parameters = { ...getParamOverrides() };
+      for (const role of roles) {
+        selection[role] = { presetId: "slot-previous-lineup" };
+        delete parameters[role];
+      }
+      delete selection["state-complex"];
+      delete parameters["state-complex"];
+      await store.setMany({ "llm.slotConfig": selection, "llm.paramOverrides": parameters });
+      setPrevious(true);
+    } catch {
+      setErrors("Could not restore Previous lineup.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <section aria-label="Voyage model tiers" className="space-y-3">
+      {roles.filter(role => state.llmConfig?.slots?.[role]).map(role => {
+        const serverDefault = state.llmConfig?.slots?.[role];
+        const active = selectedTier(role, slots[role], serverDefault?.model);
+        const result = chosen[role];
+        const selection = result?.tier === active ? result.route : undefined;
+        return (
+          <div className="space-y-1" key={role}>
+            <label className="block text-sm font-medium" htmlFor={`${id}-${role}`}>{roleNames[role]} tier</label>
+            <select id={`${id}-${role}`} value={active} disabled={busy}
+              className="w-full rounded-(--radius-control) border border-(--rule-color) bg-background px-3 py-2 text-sm"
+              onChange={event => void applyTier(role, event.target.value)}>
+              <option value="custom" disabled>Custom</option>
+              {Object.keys(tiers[role]).map(tier => <option value={tier} key={tier}>{label(tier)}</option>)}
+            </select>
+            {selection && <p role="status" className="text-sm">{roleNames[role]} uses {selection.providerName} for {selection.name}.
+              {selection.estimatedCost !== null && ` Estimated $${selection.estimatedCost.toFixed(5)} per request.`}</p>}
+            {!selection && !slots[role] && active !== "custom" && serverDefault && (
+              <p className="text-sm text-muted-foreground">{serverDefault.provider} · {serverDefault.model}</p>
+            )}
+          </div>
+        );
+      })}
+      {state.presets?.some(preset => preset.id === "slot-previous-lineup") && (
+        <Button type="button" variant="outline" disabled={busy} onClick={() => void restorePrevious()}>Use Previous lineup</Button>
+      )}
+      {previous && <p role="status" className="text-sm">Previous lineup applied to Story, Character, and State.</p>}
+      {errors && <p role="alert" className="text-sm text-destructive">{errors}</p>}
+    </section>
+  );
+}
